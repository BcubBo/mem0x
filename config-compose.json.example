{
  "mem0": {
    "llm": {
      "provider": "openai",
      "config": {
        "model": "mimo-v2.5-pro",
        "api_key": "YOUR_API_KEY",
        "openai_base_url": "https://YOUR_MIMO_API_BASE_URL/v1"
      }
    },
    "embedder": {
      "provider": "openai",
      "config": {
        "model": "BAAI/bge-m3",
        "api_key": "YOUR_API_KEY",
        "openai_base_url": "https://api.siliconflow.cn/v1"
      }
    },
    "vector_store": {
      "provider": "qdrant",
      "config": {
        "url": "http://qdrant:6333",
        "api_key": "YOUR_QDRANT_API_KEY",
        "embedding_model_dims": 1024,
        "collection_name": "mem0"
      }
    },
    "custom_instructions": "从对话中提取值得长期记住的事实。\n\n格式：[P0][tech][lane:project] 事实内容\n\n示例：\n[P0][tech] 端口从8080改为9090\n[P1][lesson] 不要随意改动生产环境\n[P2][preference] 用户偏好简洁输出"
  },
  "rerank": {
    "provider": "siliconflow",
    "config": {
      "model": "BAAI/bge-reranker-v2-m3",
      "api_key": "YOUR_API_KEY",
      "openai_base_url": "https://api.siliconflow.cn/v1"
    }
  },
  "neo4j": {
    "enabled": true,
    "uri": "bolt://neo4j:7687",
    "username": "neo4j",
    "password": "YOUR_NEO4J_PASSWORD"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 28768
  },
  "scoring": {
    "weights": {
      "vector": 0.35,
      "bm25": 0.25,
      "time": 0.15,
      "reliability": 0.1,
      "heat": 0.15,
      "confidence": 0.1
    },
    "recency_lambda": 0.05,
    "rerank_weight": 0.4
  },
  "salience": {
    "initial_value": 0.5,
    "access_boost": 0.1,
    "decay_rate": 0.023
  },
  "dedup": {
    "merge_threshold": 0.85,
    "update_threshold": 0.7
  },
  "data_dir": "data",
  "redact_names": {},
  "known_persons": [],
  "consolidation": {
    "llm": {
      "provider": "openai",
      "config": {
        "model": "mimo-v2.5-pro",
        "api_key": "YOUR_API_KEY",
        "openai_base_url": "https://YOUR_MIMO_API_BASE_URL/v1"
      }
    },
    "cursor": {
      "max_candidates": 2000,
      "interval": 7200,
      "max_merges_per_cycle": 5,
      "exact_dup_threshold": 0.95,
      "near_dup_threshold": 0.88,
      "vector_sim_threshold": 0.82,
      "jaccard_threshold": 0.45
    }
  },
  "evolve_mem": {
    "interval": 14400,
    "threshold_high": 0.7,
    "threshold_low": 0.3
  },
  "_comment_mem0_llm": "事实提取LLM配置：用于从对话中提取结构化记忆",
  "_comment_conflict": "矛盾消解配置：新旧记忆矛盾检测+并行投票",
  "_comment_consolidation": "记忆整合配置：碎片记忆合并",
  "_comment_rerank": "重排序配置：搜索结果重排序",
  "_comment_server": "服务配置：监听地址和端口",
  "_comment_scoring": "打分配置：6维打分权重",
  "conflict": {
    "llm": {
      "provider": "openai",
      "config": {
        "model": "mimo-v2.5-pro",
        "api_key": "YOUR_API_KEY",
        "openai_base_url": "https://YOUR_MIMO_API_BASE_URL/v1",
        "max_tokens": 5000,
        "max_llm_calls": 1,
        "num_votes": 1
      }
    },
    "auto_archive_threshold": 0.8,
    "notify_threshold": 0.5
  }
}